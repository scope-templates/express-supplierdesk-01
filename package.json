{
  "name": "tessary-supplier-desk",
  "version": "1.7.0",
  "private": true,
  "description": "Tessary's supplier desk: client supplier lists, check requests, the analysts' supplier file and an assistant that answers from them.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/src/server.js",
    "seed": "npm run build && node dist/scripts/write-seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false
  }
}
